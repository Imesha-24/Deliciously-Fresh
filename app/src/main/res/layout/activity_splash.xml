<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_color"
    tools:context=".activity.SplashActivity">

    <ImageView
        android:id="@+id/splashLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        tools:srcCompat="@tools:sample/avatars" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="150dp"
        android:text="@string/app_version"
        android:textColor="@color/md_theme_onErrorContainer"
        android:textSize="11sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="175dp"
        android:text="@string/app_copy"
        android:textColor="@color/md_theme_onErrorContainer"
        android:textSize="11sp" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/splashProgressBar"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="invisible"
        app:indicatorColor="@color/md_theme_primary"
        app:trackColor="@color/md_theme_primaryContainer"
        app:trackCornerRadius="8dp"
        app:trackThickness="6dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="100dp" />
</FrameLayout>